APP_ENV=development
APP_NAME=Saudi Investment AI
API_V1_PREFIX=/api/v1

# SAHMK - keep real keys only in local/server .env
SAHMK_API_KEY=
SAHMK_BASE_URL=https://api.sahmk.sa/api/v1
SAHMK_PLAN=pro
SAHMK_TIMEOUT_SECONDS=20

# PostgreSQL
POSTGRES_DB=saudi_investment_ai
POSTGRES_USER=saudi_ai
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://saudi_ai:change_me@db:5432/saudi_investment_ai

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
